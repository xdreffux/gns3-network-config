
!
! No configuration change since last restart
!
version 15.2
service timestamps debug datetime msec
service timestamps log datetime msec
service password-encryption
!
hostname R2
!
boot-start-marker
boot-end-marker
!
!
security authentication failure rate 3 log
security passwords min-length 8
enable secret 5 $1$mJvW$D1nRgZQToPPMmETLQyl8g/
!
no aaa new-model
no ip source-route
no ip icmp rate-limit unreachable
!
!
!
!
!
!
ip domain name soc.local
ip name-server 8.8.8.8
ip cef
login block-for 30 attempts 3 within 60
login delay 3
login on-failure log
login on-success log
no ipv6 cef
!
!
multilink bundle-name authenticated
!
!
archive
 log config
  logging enable
  logging size 200
  notify syslog contenttype plaintext
  hidekeys
 path tftp://192.16.64.141/$h-BACKUP-$t
 write-memory
 time-period 5
!
!
!
!
!
username admin privilege 15 secret 5 $1$Tpvy$3Meiiu0E2flxqNQe1qN9Z.
!
!
!
!
!
ip tcp synwait-time 10
! 
!
!
!
!
!
!
!
!
interface Loopback0
 ip address 2.2.2.2 255.255.255.255
!
interface FastEthernet0/0
 no ip address
 ip access-group VLAN20/30 in
 no ip proxy-arp
 duplex half
!
interface FastEthernet0/0.20
 encapsulation dot1Q 20
 ip address 192.16.64.161 255.255.255.224
 ip access-group VLAN20/30 in
 ip helper-address 192.16.64.1
 no ip proxy-arp
!
interface FastEthernet1/0
 no ip address
 ip access-group VLAN20/30 in
 no ip proxy-arp
 duplex half
!
interface FastEthernet1/0.30
 encapsulation dot1Q 30
 ip address 192.16.64.193 255.255.255.224
 ip access-group VLAN20/30 in
 ip helper-address 192.16.64.1
 no