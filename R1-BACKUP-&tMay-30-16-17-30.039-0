version 15.2
service timestamps debug datetime msec
service timestamps log datetime msec
service password-encryption
!
hostname R1
!
boot-start-marker
boot-end-marker
!
!
security authentication failure rate 3 log
security passwords min-length 8
enable secret 5 $1$S5JB$tTHSvyqGREEVfor9.d7jC.
!
aaa new-model
!
!
!
!
!
!
!
aaa session-id common
no ip source-route
no ip icmp rate-limit unreachable
!
!
!
ip dhcp relay information trust-all
ip dhcp excluded-address 192.16.64.129
ip dhcp excluded-address 192.16.64.161
ip dhcp excluded-address 192.16.64.193
ip dhcp excluded-address 192.16.64.225
ip dhcp excluded-address 192.16.64.130
ip dhcp excluded-address 192.16.64.131
!
ip dhcp pool POOL_VLAN10
 network 192.16.64.128 255.255.255.224
 dns-server 8.8.8.8 
 default-router 192.16.64.131 
!
ip dhcp pool POOL_VLAN20
 network 192.16.64.160 255.255.255.224
