!
ip dhcp pool POOL_VLAN40
 network 192.16.64.224 255.255.255.224
 default-router 192.16.64.225 
 dns-server 8.8.8.8 
!
!
!
ip domain name soc.local
ip name-server 8.8.8.8
ip cef
login block-for 30 attempts 3 within 60
login delay 3
login on-failure log
login on-success log
no ipv6 cef
!
!
no vlan accounting input
multilink bundle-name authenticated
!
!
archive
 log config
  logging enable
  logging size 200
  notify syslog contenttype plaintext
  hidekeys
 path tftp://192.16.64.141/$h-BACKUP-&t
 write-memory
!
!
!
!
!
username admin privilege 15 secret 5 $1$.J4F$CM5CbFCd8DSAYPb4Flj8I.
!
!
!
!
!
ip tcp synwait-time 10
ip ssh version 2
!
track 1 interface FastEthernet3/0 line-protocol
! 
!
!
!
!
!
!
!
!
interface Loopback0
 ip address 1.1.1.1 255.255.255.255
!
interface FastEthernet0/0
 no ip address
 no ip proxy-arp
 duplex half
!
interface FastEthernet0/0.10
 encapsulation dot1Q 10
 ip address 192.16.64.129 255.255.255.224
 no ip proxy-arp
 ip nat inside
 standby version 2
 standby 10 ip 192.16.64.131
 standby 10 priority 110
 standby 10 preempt
 standby 10 authentication SOC_PASS
 standby 10 track 1 decrement 10
 ip ospf message-digest-key 1 md5 7 031E5A1A572F167F76
!
interface FastEthernet3/0
 ip address 192.16.64.1 255.255.255.252
 ip nat inside
 ip ospf message-digest-key 1 md5 7 09564F184825202133
 duplex full
!
interface FastEthernet4/0
 ip address 192.16.64.5 255.255.255.252
 ip nat inside
 ip ospf message-digest-key 1 md5 7 12030406432B3B3712
 duplex full
!
interface FastEthernet5/0
 ip address dhcp
 ip nat outside
 duplex full
 no cdp enable
!
router ospf 1
 area 10 authentication message-digest
 passive-interface default
 no passive-interface FastEthernet3/0
 no passive-interface FastEthernet4/0
 network 1.1.1.1 0.0.0.0 area 10
 network 192.16.64.128 0.0.0.31 area 10
 network 192.16.64.0 0.0.0.255 area 10
 default-information originate
!
ip nat inside source list NAT_ACL interface FastEthernet5/0 overload
ip forward-protocol nd
!
!
no ip http server
no ip http secure-server
ip route 0.0.0.0 0.0.0.0 dhcp
!
ip access-list standard NAT_ACL
 permit 192.16.64.128 0.0.0.127
!
ip access-list extended VLAN10
 permit udp any host 192.16.64.141 eq tftp
 permit udp any host 192.16.64.141 eq syslog
 permit ip 192.16.64.128 0.0.0.31 192.16.64.128 0.0.0.31
 permit tcp any 192.16.64.128 0.0.0.31 established
 permit udp any eq domain 192.16.64.128 0.0.0.31
 permit udp any eq bootps any eq bootpc
 permit icmp any host 192.16.64.141 echo
 permit icmp any host 192.16.64.141 echo-reply
 permit udp any host 192.16.64.141 gt 1023
 permit icmp any 192.16.64.128 0.0.0.31 echo-reply
 permit icmp any 192.16.64.128 0.0.0.31 unreachable
 permit icmp any 192.16.64.128 0.0.0.31 time-exceeded
 permit tcp any eq 22 192.16.64.128 0.0.0.31 established
